<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1C1C1E">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="计算器"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"/>

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8E8E93"
        android:textSize="18sp"
        android:gravity="end"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:maxLines="1"
        android:ellipsize="start"/>

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:gravity="end"
        android:paddingHorizontal="20dp"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:maxLines="1"
        android:ellipsize="start"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="6dp">

        <Button android:text="AC" android:onClick="onClearClick" style="@style/CalcButtonOp"/>
        <Button android:text="+/-" android:onClick="onNegateClick" style="@style/CalcButtonOp"/>
        <Button android:text="%" android:onClick="onPercentClick" style="@style/CalcButtonOp"/>
        <Button android:text="÷" android:onClick="onOperatorClick" style="@style/CalcButtonOp"/>

        <Button android:text="7" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="8" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="9" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="×" android:onClick="onOperatorClick" style="@style/CalcButtonOp"/>

        <Button android:text="4" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="5" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="6" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="-" android:onClick="onOperatorClick" style="@style/CalcButtonOp"/>

        <Button android:text="1" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="2" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="3" android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="+" android:onClick="onOperatorClick" style="@style/CalcButtonOp"/>

        <Button android:text="0" android:onClick="onDigitClick" android:layout_columnSpan="2" style="@style/CalcButtonNum"/>
        <Button android:text="." android:onClick="onDigitClick" style="@style/CalcButtonNum"/>
        <Button android:text="=" android:onClick="onEqualsClick" style="@style/CalcButtonEquals"/>

    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="168dp"
        android:orientation="vertical"
        android:background="#111111"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="最近运算"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            android:paddingBottom="4dp"/>

        <LinearLayout
            android:id="@+id/historyList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>

</LinearLayout>
